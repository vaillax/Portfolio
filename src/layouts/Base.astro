---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { profile } from "../data/site";

const title = `${profile.name} · Software Engineer`;
const description = `${profile.tagline} ${profile.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}. ${profile.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline src="/scripts/no-js.js"></script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />

    <script is:inline type="module" src="/scripts/reveal.js"></script>

    <style>
      .skip {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 100;
        padding: 0.5rem 0.9rem;
        background: var(--maize);
        color: #000;
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 0.85rem;
      }
      .skip:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
