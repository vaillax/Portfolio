---
import { profile, links } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="hero" id="top">
  <div class="container">
    <p class="mono term reveal">
      <span class="p">~/{profile.handle}</span> <span class="dollar">$</span> whoami<span class="cursor" aria-hidden="true"></span>
    </p>

    <h1 class="reveal" style="--d: 80ms">{profile.name}</h1>

    <p class="tagline reveal" style="--d: 160ms">{profile.tagline}</p>
    <p class="sub reveal" style="--d: 220ms">{profile.subtitle}</p>

    <div class="actions reveal" style="--d: 300ms">
      <a class="btn btn-primary" href={profile.resume} target="_blank" rel="noopener">
        <Icon name="file" /> Resume
      </a>
      <a class="btn" href={links.github} target="_blank" rel="noopener">
        <Icon name="github" /> GitHub
      </a>
      <a class="btn" href={links.linkedin} target="_blank" rel="noopener">
        <Icon name="linkedin" /> LinkedIn
      </a>
    </div>

    <ul class="meta mono reveal" style="--d: 380ms">
      <li><span class="dot" aria-hidden="true"></span>{profile.status}</li>
      <li>{profile.location}</li>
      <li>U-M · Class of {profile.graduation.split(" ")[1]}</li>
    </ul>
  </div>

  <a href="#about" class="scroll mono" aria-label="Scroll to About">scroll ↓</a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 7rem 0 5rem;
  }
  .term {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }
  .p {
    color: var(--blue);
  }
  .dollar {
    color: var(--maize);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.3em;
    vertical-align: -0.2em;
    background: var(--maize);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  h1 {
    font-size: clamp(2.6rem, 9vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    background: linear-gradient(180deg, #fff 30%, #a9aebb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    margin-top: 1.5rem;
    font-size: clamp(1.2rem, 2.8vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    max-width: 30ch;
    color: var(--text);
  }
  .sub {
    margin-top: 1rem;
    max-width: 56ch;
    color: var(--text-dim);
    font-size: 1.02rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.75rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .meta li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .meta li:first-child {
    color: var(--text-dim);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px rgba(61, 220, 132, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0);
    }
  }
  .scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    font-size: 0.72rem;
    color: var(--text-faint);
    transition: color 0.2s;
  }
  .scroll:hover {
    color: var(--maize);
  }
  @media (max-height: 640px) {
    .scroll {
      display: none;
    }
  }
</style>
