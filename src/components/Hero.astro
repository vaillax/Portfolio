---
import { profile, links } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="hero" id="top">
  <div class="container">
    <h1>{profile.name}</h1>

    <p class="tagline">{profile.tagline}</p>
    <p class="sub">{profile.subtitle}</p>

    <div class="actions">
      <a class="btn btn-primary" href={profile.resume} target="_blank" rel="noopener">
        <Icon name="file" /> Resume
      </a>
      <a class="btn" href={`mailto:${links.email}`}>
        <Icon name="mail" /> Email
      </a>
      <a class="btn" href={links.github} target="_blank" rel="noopener">
        <Icon name="github" /> GitHub
      </a>
      <a class="btn" href={links.linkedin} target="_blank" rel="noopener">
        <Icon name="linkedin" /> LinkedIn
      </a>
    </div>

    <ul class="meta mono">
      <li><span class="dot" aria-hidden="true"></span>{profile.status}</li>
      <li>{profile.location}</li>
      <li>U-M · Class of {profile.graduation.split(" ")[1]}</li>
    </ul>
  </div>
</section>

<style>
  /* Sized to its content (not the full viewport) so the next section shows on the first screen. */
  .hero {
    padding: clamp(7.5rem, 16vw, 10rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
  h1 {
    font-size: clamp(2.6rem, 9vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    background: linear-gradient(180deg, #fff 30%, #a9aebb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    margin-top: 1.5rem;
    font-size: clamp(1.2rem, 2.8vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    max-width: 30ch;
    color: var(--text);
  }
  .sub {
    margin-top: 1rem;
    max-width: 56ch;
    color: var(--text-dim);
    font-size: 1.02rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2.75rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .meta li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .meta li:first-child {
    color: var(--text-dim);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px rgba(61, 220, 132, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0);
    }
  }
  @media (max-width: 480px) {
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .actions .btn {
      justify-content: center;
    }
  }
</style>
