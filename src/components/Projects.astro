---
import { projects } from "../data/site";
import SectionHeader from "./SectionHeader.astro";
import ImageSlot from "./ImageSlot.astro";
import Icon from "./Icon.astro";

const visible = projects.filter((p) => !p.hidden);
const featured = visible.filter((p) => p.featured);
const others = visible.filter((p) => !p.featured);
---

<section class="section" id="projects">
  <div class="container">
    <SectionHeader index="03" label="projects" title="Things I've built" />

    <div class="featured">
      {featured.map((p, i) => (
        <article class="card glow feat reveal" style={`--d:${(i % 2) * 80}ms`}>
          {p.image && <ImageSlot src={p.image} alt={p.title} seed={i} />}
          <div class="content">
            <p class="mono kicker">{p.kicker}</p>
            <h3>{p.title}</h3>
            <p class="desc">{p.description}</p>
            <div class="foot">
              <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
              {p.links && p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l) => (
                    <a href={l.href} class="mono" target="_blank" rel="noopener">
                      {l.label} <Icon name="external" />
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <h3 class="mono more reveal">other work</h3>
    <div class="others">
      {others.map((p, i) => (
        <article class="card glow small reveal" style={`--d:${(i % 4) * 60}ms`}>
          <p class="mono kicker">{p.kicker}</p>
          <h4>{p.title}</h4>
          <p class="desc">{p.description}</p>
          <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          {p.links && p.links.length > 0 && (
            <div class="links small-links">
              {p.links.map((l) => (
                <a href={l.href} class="mono" target="_blank" rel="noopener">
                  {l.label} <Icon name="external" />
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .featured {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .feat {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
  }
  .feat:hover {
    transform: translateY(-3px);
  }
  .content {
    padding: 1.1rem 0.6rem 0.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .kicker {
    font-size: 0.72rem;
    color: var(--maize);
    margin-bottom: 0.45rem;
  }
  h3 {
    font-size: 1.25rem;
  }
  .desc {
    color: var(--text-dim);
    font-size: 0.93rem;
    margin: 0.7rem 0 1.2rem;
  }
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--text-dim);
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--maize);
  }
  .links :global(svg) {
    width: 14px;
    height: 14px;
  }
  .small-links {
    margin-top: 1rem;
  }
  .more {
    margin: clamp(3rem, 7vw, 4rem) 0 1.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-faint);
    letter-spacing: 0;
  }
  .more::before {
    content: "// ";
    color: var(--blue);
  }
  .others {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .small {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .small h4 {
    font-size: 1rem;
  }
  .small .desc {
    font-size: 0.86rem;
    flex: 1;
  }
  @media (max-width: 960px) {
    .others {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .featured,
    .others {
      grid-template-columns: 1fr;
    }
  }
</style>
