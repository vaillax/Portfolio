---
import { contact, links, profile } from "../data/site";
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";
---

<section class="section" id="contact">
  <div class="container">
    <SectionHeader label="contact" title={contact.heading} />
    <div class="wrap reveal">
      <p class="text">{contact.text}</p>
      <a class="email mono" href={`mailto:${links.email}`}>
        {links.email}
        <Icon name="arrow" />
      </a>
      <div class="row">
        <a class="btn" href={links.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        <a class="btn" href={links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a class="btn" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" /> Resume</a>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>Built with Astro · Ann Arbor, MI</span>
  </div>
</footer>

<style>
  .wrap {
    max-width: 640px;
  }
  .text {
    color: var(--text-dim);
    font-size: 1.1rem;
  }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    font-size: clamp(1.05rem, 3.5vw, 1.5rem);
    color: var(--maize);
    border-bottom: 1px solid rgba(255, 203, 5, 0.3);
    padding-bottom: 0.25rem;
    word-break: break-all;
    transition: border-color 0.2s;
  }
  .email:hover {
    border-color: var(--maize);
  }
  .email :global(svg) {
    width: 1em;
    height: 1em;
    flex: none;
    transition: transform 0.25s var(--ease);
  }
  .email:hover :global(svg) {
    transform: translateX(4px);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0;
  }
  .footer .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-faint);
  }
</style>
