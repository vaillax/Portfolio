---
interface Props {
  index: string;
  label: string;
  title: string;
}
const { index, label, title } = Astro.props;
---

<header class="sh reveal">
  <p class="mono kicker"><span class="idx">{index}</span> <span class="slash">//</span> {label}</p>
  <h2>{title}</h2>
</header>

<style>
  .sh {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .kicker {
    font-size: 0.8rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
  }
  .idx {
    color: var(--maize);
  }
  .slash {
    color: var(--blue);
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }
</style>
