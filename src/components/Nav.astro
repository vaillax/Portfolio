---
import { nav, profile } from "../data/site";
---

<header class="nav" id="nav">
  <div class="container inner">
    <a href="#top" class="logo mono" aria-label="Back to top">
      <span class="prompt">~/</span>{profile.handle}<span class="caret">_</span>
    </a>

    <nav id="menu" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} class="mono">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Outside the menu so it stays one tap away on phones. -->
    <a href={profile.resume} class="mono resume" target="_blank" rel="noopener">Resume</a>

    <button class="toggle" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script is:inline type="module" src="/scripts/nav.js"></script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .nav.scrolled {
    background: rgba(8, 9, 12, 0.95);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-color: var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 4rem;
  }
  .logo {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .prompt {
    color: var(--blue);
  }
  .caret {
    color: var(--maize);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  nav a {
    font-size: 0.8rem;
    color: var(--text-dim);
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--text);
  }
  .resume {
    position: relative;
    z-index: 2;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--maize);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--maize);
    transition: background 0.2s;
  }
  .resume:hover {
    background: var(--maize-soft);
  }
  .toggle {
    display: none;
  }
  /* backdrop-filter creates a containing block, which would trap the fixed mobile menu */
  .nav.open {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: transparent;
  }
  .logo {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 760px) {
    .inner {
      gap: 0.5rem;
    }
    .resume {
      margin-left: auto;
      padding: 0.55rem 0.8rem;
    }
    .toggle {
      display: grid;
      gap: 6px;
      place-content: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      background: none;
      border: 0;
      cursor: pointer;
      position: relative;
      z-index: 2;
    }
    .toggle span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.3s var(--ease);
    }
    .open .toggle span:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    .open .toggle span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
    nav {
      position: fixed;
      inset: 0;
      margin: 0;
      background: rgba(8, 9, 12, 0.97);
      backdrop-filter: blur(10px);
      display: grid;
      place-items: center;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease),
        visibility 0.3s;
    }
    .open nav {
      opacity: 1;
      visibility: visible;
    }
    nav ul {
      flex-direction: column;
      gap: 1.75rem;
      text-align: center;
    }
    nav a {
      font-size: 1.15rem;
      color: var(--text);
    }
  }
</style>
